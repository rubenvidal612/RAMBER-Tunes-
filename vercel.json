{
  "version": 2,
  "functions": {
    "api/[...route].ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/share/preview/cleanup-expired",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/mercadopago/expire-batches",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/storage/cleanup-audio",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...route]"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/index.html"
    }
  ]
}
