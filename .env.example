# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 Configuration (for audio file storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="ramber-tunes-audio"
R2_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://your-public-r2-domain.example.com"

# Suno API Configuration
SUNO_API_KEY="your-suno-api-key"
SUNO_BASE_URL="https://api.suno.ai"

# Kits.ai API Configuration (for voice cloning)
KITS_API_KEY="your-kits-api-key"

# OpenAI API Configuration
OPENAI_API_KEY="your-openai-api-key"
KITS_BASE_URL="https://api.kits.ai"
KITS_VOICE_MODEL_ID="1014961"

# Anthropic API Configuration (for LucIAna Bot web chat)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Mastering (FFmpeg loudnorm)
# Ruta principal recomendada: procesa "Masterizar" en tu VPS y no en Vercel.
# El endpoint debe aceptar POST JSON: { inputUrl, outputUploadUrl, ffmpegArgs } y responder { ok: true }.
MASTERING_WORKER_URL="https://srv1698218.hstgr.cloud/masterize"
# Respaldo opcional: deja "false" para desactivar la ejecución local en Vercel.
MASTERING_ALLOW_LOCAL_FALLBACK="false"

# Video Karaoke / Youka (servidor solamente)
# Mantener desactivado hasta autorizar la integración real y configurar la clave.
KARAOKE_YOUKA_ENABLED="false"
YOUKA_API_KEY=""
YOUKA_API_BASE_URL="https://api.youka.io/api/v1"
KARAOKE_CREDIT_MULTIPLIER="1"
KARAOKE_CREDIT_FIXED="0"
KARAOKE_DOWNLOAD_TTL_HOURS="72"

# Arpeggi API Configuration (alternative to Kits.ai)
ARPEGGI_API_KEY="your-arpeggi-api-key"
ARPEGGI_API_URL="https://arpeggi.io/api/kits/v1/voice-conversions"
ARPEGGI_VOICE_MODEL_ID="1014961"

# Replicate API Configuration (for RVC voice cloning)
REPLICATE_API_TOKEN="your-replicate-api-token"
REPLICATE_RVC_MODEL="replicate/train-rvc-model"
REPLICATE_RVC_VERSION="cf360587a27f67500c30fc31de1e0f0f9aa26dcd7b866e6ac937a07bd104bad9"

# Application Settings
NEXT_PUBLIC_APP_NAME="RAMBER Tunes"
NEXT_PUBLIC_DEFAULT_CREDITS=2
